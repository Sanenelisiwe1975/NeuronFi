{
  "name": "neuronfi",
  "private": true,
  "description": "NeuronFi — Autonomous DeFi Agent on Kite chain | Kite AI Hackathon",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "agent:start": "turbo run start --filter=@repo/agent",
    "agent:dev": "turbo run dev --filter=@repo/agent"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ethers": "^6.16.0",
    "hardhat": "^3.1.12",
    "prettier": "^3.7.4",
    "turbo": "^2.8.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/web",
    "packages/agent",
    "packages/kite",
    "packages/data",
    "packages/planner",
    "packages/typescript-config"
  ],
  "dependencies": {
    "@langchain/anthropic": "^1.3.23",
    "@langchain/core": "^1.1.32",
    "@ton/crypto": "^3.3.0",
    "dotenv": "^17.4.2",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  }
}
